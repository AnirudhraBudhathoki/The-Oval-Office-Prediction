# Import the data
nc <- read_csv("D:/usersDESKTOP-ID246HMUsers/Desktop/Step2/New folder/FinalColorado.csv",show_col_types = FALSE)

# Exclude MOE columns
nc1 = nc[,!grepl("DisabilityStatus$|HealthCoverage$|Count$|MortgageStatus$",names(nc))]

#Remove rows with totals
nc1 = nc1[!grepl("Total population|All people", nc1$Title),]


str(nc1)

# Specify the specific columns you want to unpivot
Party_columns <- c("LeadingParty", "TargetParty")  # Example: choose specific columns
# Unpivot the district columns
unpivoted_nc1 = nc1 %>% 
  pivot_longer(
    cols =  all_of(Party_columns),
    names_to = "LeadingParty",
    values_to = "TargetParty",
    values_drop_na = TRUE
)

view(unpivoted_nc1)

data <- reactive({
  req(input$sel_Subject)  # Ensure sel_Subject is selected
  df <- unpivoted_nc1 %>%
    filter(Subject %in% input$sel_Subject) %>%
    group_by(District) %>%
    summarise(Population = sum(LeadingParty))  # Sum population
  df  # Return df at the end of the reactive block
})

